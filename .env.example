# PRODUCTION AUTHORITY: Azure only. Vercel/Render/Railway/AWS/GCP are retired.
# Runtime secrets are stored in Azure Key Vault and resolved through the Azure
# service Managed Identity. GitHub OIDC is bootstrap/rotation authority only.
# This committed file is a names-only catalog, never a production value source.
# GEMINI_API_KEY: Required for Gemini AI API calls.
# Azure App Service resolves this in production from a Key Vault reference.
# For local development only, provide it through an uncommitted environment file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Azure App Service injects the governed Azure application URL at runtime.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# dsg-one-v1 Supabase environment isolation
# Do not reuse Supabase env values from another repository or retired hosting provider.
# This repo must use its own project-scoped variables.

# Public browser-safe values for this repo only.
NEXT_PUBLIC_DSG_ONE_V1_SUPABASE_URL=""
NEXT_PUBLIC_DSG_ONE_V1_SUPABASE_PUBLISHABLE_KEY=""

# Server-only values for this repo only. Never expose in client code.
DSG_ONE_V1_SUPABASE_URL=""
DSG_ONE_V1_SUPABASE_SERVICE_ROLE_KEY=""

# Optional local-only compatibility bridge. Do not enable for production.
DSG_ALLOW_DEV_HEADER_ACTOR="false"

# Optional governed AI gateway providers. Server-side only; never expose these in client code.
OPENAI_API_KEY=""
OPENAI_API_BASE=""
ANTHROPIC_API_KEY=""
# GEMINI_API_KEY is listed above; GOOGLE_GENERATIVE_AI_API_KEY is accepted as a compatibility alias.
GOOGLE_GENERATIVE_AI_API_KEY=""

# Remote browser provider registry.
# These values only make providers env-ready. They do not claim verified autonomous browser execution
# until the corresponding executor adapter is implemented and tested.
PLAYWRIGHT_CDP_WS_ENDPOINT=""
PLAYWRIGHT_DEFAULT_CONTEXT_ID=""
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""
BROWSERBASE_REGION=""
BROWSERBASE_PROJECT_NAME=""
STEEL_API_KEY=""
STEEL_BASE_URL=""

# ── Stream 1: Template Marketplace ───────────────────────────────────────────
# Stripe secret key (server-only — never expose in client code)
STRIPE_SECRET_KEY=""

# Stripe webhook signing secret
# Register endpoint: https://<your-domain>/api/webhooks/stripe
# Events: checkout.session.completed, invoice.paid
STRIPE_WEBHOOK_SECRET=""

# Canonical app URL (used in Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=""

# ── Stream 2: MCP API Key Billing ─────────────────────────────────────────────
# Stripe Price ID for DSG ONE MCP ฿490/month subscription
# Create in Stripe Dashboard: Products → New → Recurring ฿490/month → copy Price ID
STRIPE_MCP_PRICE_ID=""

# Set in the MCP client environment (not in Next.js app)
# Obtain from /dsg/api-keys after subscribing
DSG_API_KEY=""

# ── DSG AIMO MCP Gateway ──────────────────────────────────────────────────────
# Registry carries non-secret service URLs. The root secret derives only the
# simulation/cinema service tokens. Control Plane /api/dsg/v1 auth uses its own
# canonical persisted DSG API key and must not be simulated with a derived token.
DSG_AIMO_SERVICE_REGISTRY='{"simulationUrl":"https://<agi-host>","cinemaUrl":"https://<cinema-host>","controlPlaneUrl":"https://<control-plane-host>","maxParallelism":16}'
DSG_AIMO_ROOT_KEY=""
DSG_CONTROL_PLANE_API_KEY=""

# Server-to-server HMAC used only for candidate-realization admission receipts.
# The same value must be configured on DSG Control Plane. Keep it in Azure Key Vault.
DSG_REALIZATION_AUTHORIZATION_SECRET=""

# Dedicated HMAC for dsg-agi-simulation -> DSG ONE candidate intake.
# Do not reuse DSG_REALIZATION_AUTHORIZATION_SECRET: simulation must never be able
# to forge a Control Plane authorization receipt.
DSG_BUILDER_CANDIDATE_INTAKE_SECRET=""
# Audit identity used only after the HMAC passes. The actor must be an existing
# member of the configured workspace with the job:create permission.
DSG_BUILDER_SERVICE_WORKSPACE_ID=""
DSG_BUILDER_SERVICE_ACTOR_ID=""

# NVIDIA NIM — Ising model is advisory strategy input, not authoritative verifier.
NVIDIA_API_KEY=""
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com"
NVIDIA_ISING_MODEL="nvidia/ising-calibration-1.5-31b"

# Legacy/override compatibility. Leave empty in normal MCP-gateway mode.
# A service-specific key overrides the derived DSG_AIMO_ROOT_KEY token.
DSG_AGI_SIMULATION_URL=""
DSG_AGI_SIMULATION_API_KEY=""
DSG_CINEMA_PROOF_URL=""
DSG_CINEMA_PROOF_API_KEY=""
DSG_CONTROL_PLANE_URL=""
DSG_AIMO_MAX_PARALLELISM=""

# ── First Value lifecycle handoff (server-only) ───────────────────────────────
# Uses ActiveCampaign API v3 contact tags. API token belongs in Azure Key Vault.
# Tag IDs are account-scoped identifiers, not secrets, and are configured server-side.
ACTIVECAMPAIGN_API_URL=""
ACTIVECAMPAIGN_API_TOKEN=""
ACTIVECAMPAIGN_TAG_VERIFICATION_STARTED_ID=""
ACTIVECAMPAIGN_TAG_PROOF_CREATED_ID=""
ACTIVECAMPAIGN_TAG_PROOF_VIEWED_ID=""
